{
  "name": "@absmartly/mcp",
  "version": "2.0.0",
  "description": "MCP server for ABsmartly — experimentation platform API access for AI assistants",
  "main": "./dist/cjs/core.js",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "absmartly-mcp": "bin/absmartly-mcp.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/cjs/types/core.d.ts",
        "default": "./dist/cjs/core.js"
      },
      "default": "./dist/core.js"
    },
    "./node-http": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/cjs/types/core.d.ts",
        "default": "./dist/cjs/core.js"
      },
      "default": "./dist/core.js"
    },
    "./oauth": {
      "import": {
        "types": "./dist/oauth/index.d.ts",
        "default": "./dist/oauth/index.js"
      },
      "require": {
        "types": "./dist/cjs/types/oauth/index.d.ts",
        "default": "./dist/cjs/oauth.js"
      },
      "default": "./dist/oauth/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./endpoint-manifest.json": "./endpoint-manifest.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node-http": [
        "./dist/core.d.ts"
      ],
      "oauth": [
        "./dist/oauth/index.d.ts"
      ],
      "worker": [
        "./dist/worker.d.ts"
      ]
    }
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "public/docs/",
    "endpoint-manifest.json"
  ],
  "scripts": {
    "prebuild": "node scripts/sync-version.js",
    "build": "tsc && node scripts/build-cjs.mjs && node scripts/build-cjs-types.mjs",
    "predev": "node scripts/sync-version.js",
    "dev": "wrangler dev",
    "predeploy": "node scripts/sync-version.js",
    "deploy": "npm run test && ./scripts/build-dxt.sh && ./scripts/deploy-with-verify.sh",
    "deploy:staging": "npm run test && wrangler deploy --env staging",
    "deploy:production": "npm run test && wrangler deploy --env production",
    "deploy:force": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "start": "wrangler dev",
    "bridge": "node mcp-bridge.js",
    "local-server": "tsx src/local-server.ts",
    "test": "tsx tests/test-runner.js --unit-only",
    "test:unit": "tsx tests/test-runner.js --unit-only",
    "test:integration": "tsx tests/test-runner.js --integration-only",
    "test:all": "tsx tests/test-runner.js",
    "test:resources": "node tests/unit/resources-prompts.test.js",
    "test:legacy": "npm run test:api && npm run test:server && npm run test:bridge",
    "test:server": "node test-server.js",
    "test:bridge": "node test-bridge.js",
    "test:api": "node test-local-api.js",
    "test:claude": "node tests/integration/claude-mcp-tools.test.js",
    "test:dynamic": "node test-dynamic-fields-complete.js",
    "test:dynamic:full": "./run-dynamic-fields-test.sh",
    "precommit": "npm run test",
    "clean-whitespace": "find src -name '*.ts' -exec sed -i '' 's/^[[:space:]]*$//' {} +",
    "build:dxt": "mkdir -p public && dxt pack . public/absmartly-mcp.dxt",
    "upload:dxt": "./scripts/build-dxt.sh",
    "install:dxt": "npm install -g @anthropic-ai/dxt",
    "manifest": "tsx scripts/endpoint-manifest.ts",
    "manifest:check": "tsx scripts/endpoint-manifest.ts --check",
    "check:cjs-consumer": "node scripts/check-cjs-consumer.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "absmartly",
    "cloudflare-workers",
    "experimentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absmartly/mcp.git"
  },
  "author": "ABsmartly",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.67"
  },
  "peerDependencies": {
    "@absmartly/cli": ">=1.7.0 <2",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "agents": "^0.0.95",
    "hono": "^4.12.25"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-oauth-provider": {
      "optional": true
    },
    "agents": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@absmartly/cli": "^1.14.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/node": "^20.11.0",
    "agents": "^0.0.95",
    "dotenv": "^17.0.0",
    "esbuild": "0.27.3",
    "hono": "^4.12.25",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.103.0"
  }
}
